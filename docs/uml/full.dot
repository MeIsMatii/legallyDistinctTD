digraph "src" {

splines  = ortho;
fontname = "Inconsolata";

node [colorscheme = ylgnbu4];
edge [colorscheme = dark28, dir = both];

Animations                [shape = record, label = "{ \<\<interface\>\>\nAnimations | + addedToWorld(World) : void\l + playAnimation() : void\l + startAnimation() : void\l + isAnimating(boolean) : void\l + generateFrameList() : void\l| frameList : List\<String\>\l  spritePath : String\l  spriteName : String\l  animationSpeed : int\l  currentFrameIndex : int\l  frameCounter : int\l }"];
